---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const englishHome = `${base}en/`;
const japaneseHome = `${base}ja/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${englishHome}`} />
    <title>SciOxide Handbook</title>
    <script is:inline define:vars={{ englishHome }}>
      window.location.replace(englishHome);
    </script>
  </head>
  <body>
    <main>
      <h1>SciOxide Handbook</h1>
      <p>Redirecting to the English handbook.</p>
      <p>
        <a href={englishHome}>Continue in English</a>
        ·
        <a href={japaneseHome} lang="ja">日本語で読む</a>
      </p>
    </main>
  </body>
</html>
